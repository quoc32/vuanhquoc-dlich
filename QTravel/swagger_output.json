        ],
        "description": "Lấy danh sách Offer từ một Offer Request (có phân trang)",
        "parameters": [
          {
            "name": "offer_request_id",
            "in": "query",
            "description": "ID của Offer Request",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Số lượng kết quả trả về tối đa (Mặc định 50, tối đa 200)",
            "type": "integer"
          },
          {
            "name": "after",
            "in": "query",
            "description": "Con trỏ cursor để phân trang (lấy từ trường meta.after của response trước đó)",
            "type": "string"
          },
          {
            "name": "params",
            "in": "query",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
