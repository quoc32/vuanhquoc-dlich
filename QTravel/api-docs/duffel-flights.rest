        "gender": "m"
      }
    ]
  }
}

###

@orderId = ord_0000A...

# 3.2 Get a specific Order
# @name getOrder
GET {{baseUrl}}/air/orders/{{orderId}}
Authorization: Bearer {{token}}
Duffel-Version: {{duffelVersion}}

###

# 3.3 List Orders
# @name listOrders
GET {{baseUrl}}/air/orders?limit=20
Authorization: Bearer {{token}}
Duffel-Version: {{duffelVersion}}

### ==========================================
### 4. REFERENCE DATA
### ==========================================

# 4.1 List Airlines
# @name listAirlines
GET {{baseUrl}}/air/airlines?limit=20
Authorization: Bearer {{token}}
Duffel-Version: {{duffelVersion}}

###

# 4.2 List Aircrafts
# @name listAircrafts
GET {{baseUrl}}/air/aircraft?limit=20
Authorization: Bearer {{token}}
Duffel-Version: {{duffelVersion}}

### ==========================================
### 5. PAYMENTS (Thanh toán Order Hold)
### ==========================================

# @name payForOrder
POST {{baseUrl}}/air/payments
Authorization: Bearer {{token}}
Duffel-Version: {{duffelVersion}}
Content-Type: application/json

{
  "data": {
    "order_id": "{{orderId}}",
    "payment": {
      "type": "balance",
      "currency": "VND", 
      "amount": "1500000" 
    }
  }
}

